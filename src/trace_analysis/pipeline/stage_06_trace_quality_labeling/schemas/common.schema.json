        "case_requirement_id",
        "taxonomy_row",
        "parent_requirement_id",
        "mapping_status",
        "claim_ids"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mapping_status": {
                "const": "supported"
              }
            }
          },
          "then": {
            "properties": {
              "taxonomy_row": {
                "type": "integer"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mapping_status": {
                "const": "partial"
              }
            }
          },
          "then": {
            "properties": {
              "taxonomy_row": {
                "type": "null"
              },
              "parent_requirement_id": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mapping_status": {
                "const": "unresolved"
              }
            }
          },
          "then": {
            "properties": {
              "taxonomy_row": {
                "type": "null"
              },
              "parent_requirement_id": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "difficulty_dimension": {
      "type": "object",
      "properties": {
        "level": {
          "enum": [
            0,
            1,
            2,
            3,
            "unknown"
          ]
        },
        "claim_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "level",
        "claim_ids"
      ],
      "additionalProperties": false
    },
    "task_attributes": {
      "type": "object",
      "properties": {
        "domain_primary": {
          "enum": [
            "化学",
            "工科",
            "数学",
            "材料",
            "物理",
            "环境",
            "生物",
            "计算机",
            "unknown"
          ]
        },
        "domain_secondary": {
          "type": "array",
          "items": {
            "enum": [
              "化学",
              "工科",
              "数学",
              "材料",
              "物理",
              "环境",
              "生物",
              "计算机"
            ]
          },
          "uniqueItems": true
        },
        "work_object_primary": {
          "enum": [
            "文献与外部证据",
            "科学问题",
            "研究方案",
            "环境",
            "数据",
            "代码",
            "实验",
            "论文",
            null
          ]
        },
        "work_object_secondary": {
          "type": "array",
          "items": {
            "enum": [
              "文献与外部证据",
              "科学问题",
              "研究方案",
              "环境",
              "数据",
              "代码",
              "实验",
              "论文"
            ]
          },
          "uniqueItems": true
        },
        "difficulty": {
          "enum": [
            "low",
            "medium",
            "high",
            "unknown"
          ]
        },
        "difficulty_dimensions": {
          "type": "object",
          "properties": {
            "scientific_reasoning": {
              "$ref": "common.schema.json#/$defs/difficulty_dimension"
            },
            "constraint_complexity": {
              "$ref": "common.schema.json#/$defs/difficulty_dimension"
            },
            "workflow_dependencies": {
              "$ref": "common.schema.json#/$defs/difficulty_dimension"
            },
            "environment_and_tools": {
              "$ref": "common.schema.json#/$defs/difficulty_dimension"
            },
            "verification_burden": {
              "$ref": "common.schema.json#/$defs/difficulty_dimension"
            }
          },
          "required": [
            "scientific_reasoning",
            "constraint_complexity",
            "workflow_dependencies",
            "environment_and_tools",
            "verification_burden"
          ],
          "additionalProperties": false
        },
        "difficulty_factors": {
          "type": "array",
          "items": {
            "enum": [
              "cross_artifact",
              "external_information_dependency",
              "goal_evolution",
              "long_horizon_state",
              "multi_step",
              "scientific_reasoning",
              "tool_dependency",
              "verification_burden"
            ]
          },
          "uniqueItems": true
        },
        "claim_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "domain_primary",
        "domain_secondary",
        "work_object_primary",
        "work_object_secondary",
        "difficulty",
        "difficulty_dimensions",
        "difficulty_factors",
        "claim_ids"
      ],
      "additionalProperties": false
    },
    "feedback": {
      "type": "object",
      "properties": {
        "feedback_id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "missing_initial_spec",
            "model_correction",
            "goal_change",
            "natural_deepening",
            "acknowledgement",
            "uncertain"
          ]
        },
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "target_requirement_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "prior_output_evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "requirement_evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "claim_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "feedback_id",
        "type",
        "evidence_id",
        "target_requirement_ids",
        "prior_output_evidence_ids",
        "requirement_evidence_ids",
        "claim_ids"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "model_correction"
              }
            }
          },
          "then": {
            "properties": {
              "prior_output_evidence_ids": {
                "minItems": 1
              },
              "requirement_evidence_ids": {
                "minItems": 1
              },
              "target_requirement_ids": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "failure": {
      "type": "object",
      "properties": {
        "failure_id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "artifact_delivery_failure",
            "constraint_loss",
            "context_tracking_failure",
            "error_recovery_failure",
            "incomplete_execution",
            "tool_misuse",
            "unknown",
            "verification_failure",
            "wrong_assumption"
          ]
        },
        "target_requirement_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "claim_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "failure_id",
        "type",
        "target_requirement_ids",
        "claim_ids"
      ],
      "additionalProperties": false
    },
    "evidence_scope": {
      "type": "object",
      "properties": {
        "strategy": {
          "enum": [
            "complete_episode",
            "indexed_retrieval"
          ]
        },
        "full_episode_read": {
          "type": "boolean"
        },
        "provided_event_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "omitted_body_event_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "retrieval_rounds": {
          "type": "integer",
          "minimum": 0
        },
        "feedback_scan_status": {
          "enum": [
            "complete",
            "partial",
            "not_assessed"
          ]
        },
        "coverage_notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "strategy",
        "full_episode_read",
        "provided_event_ids",
        "omitted_body_event_ids",
        "retrieval_rounds",
        "feedback_scan_status",
        "coverage_notes"
      ],
      "additionalProperties": false
    },
    "claim_review": {
      "type": "object",
      "properties": {
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "support_status": {
          "enum": [
            "supported",
            "partial",
            "unsupported",
            "unknown"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
