{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trace-analysis.local/schemas/stage06/v1/common.schema.json",
  "$defs": {
    "source_locator": {
      "type": "object",
      "properties": {
        "source_file": {
          "type": "string",
          "minLength": 1
        },
        "record_index": {
          "type": "integer",
          "minimum": 0
        },
        "physical_line": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      },
      "required": [
        "source_file",
        "record_index",
        "physical_line"
      ],
      "additionalProperties": false
    },
    "evidence_ref": {
      "type": "object",
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "turn_id": {
          "type": "string",
          "minLength": 1
        },
        "source_role": {
          "enum": [
            "user",
            "assistant",
            "tool",
            "system",
            "error"
          ]
        },
        "quote": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "$ref": "common.schema.json#/$defs/source_locator"
        },
        "episode_membership": {
          "enum": [
            "episode",
            "prior_context",
            "post_episode_context"
          ]
        }
      },
      "required": [
        "evidence_id",
        "event_id",
        "turn_id",
        "source_role",
        "quote",
        "locator",
        "episode_membership"
      ],
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "properties": {
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "field_path": {
          "type": "string",
          "minLength": 1
        },
        "target_id": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "missing_evidence_queries": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "conflicting_evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "support_status": {
          "enum": [
            "supported",
            "partial",
            "unsupported",
            "unknown"
          ],
          "description": "标签证据支持状态：评价 field_path 指向的具体标签主张，不评价整个 Trace。初标为待复核判断，实际复核意见由 review.claim_reviews 记录。"
        },
        "is_core": {
          "type": "boolean"
        }
      },
      "required": [
        "claim_id",
        "field_path",
        "target_id",
        "reason",
        "evidence_ids",
        "missing_evidence_queries",
        "conflicting_evidence_ids",
        "support_status",
        "is_core"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "support_status": {
                "const": "supported"
              }
            }
          },
          "then": {
            "properties": {
              "evidence_ids": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "case_requirement": {
      "type": "object",
      "properties": {
        "case_requirement_id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "origin": {
          "enum": [
            "initial_query",
            "clarified_later",
            "new_later",
            "unknown"
          ]
        },
        "is_core": {
          "type": "boolean"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "historical_requirement_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "required": [
        "case_requirement_id",
        "text",
        "origin",
        "is_core",
        "evidence_ids",
        "historical_requirement_id"
      ],
      "additionalProperties": false
    },
    "assessment_target": {
      "type": "object",
      "properties": {
        "target_id": {
          "type": "string",
          "minLength": 1
        },
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "core_requirement_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "noncore_requirement_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "boundary_status": {
          "enum": [
            "confirmed",
            "needs_review",
            "unknown"
          ]
        },
        "claim_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "target_id",
        "goal",
        "core_requirement_ids",
        "noncore_requirement_ids",
        "boundary_status",
        "claim_ids"
      ],
      "additionalProperties": false
    },
    "assessment": {
      "type": "object",
      "properties": {
        "assessment_id": {
          "type": "string",
          "minLength": 1
        },
        "target_id": {
          "type": "string",
          "minLength": 1
        },
        "gates": {
          "type": "object",
          "properties": {
            "goal_observable": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "agent_behavior_observable": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "outcome_observable": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "evidence_sufficient": {
              "type": [
                "boolean",
                "null"
              ]
            }
          },
          "required": [
            "goal_observable",
            "agent_behavior_observable",
            "outcome_observable",
            "evidence_sufficient"
          ],
          "additionalProperties": false
        },
        "episode_integrity": {
          "enum": [
            "complete",
            "partial",
            "broken",
            "unknown"
          ]
        },
        "evidence_status": {
          "enum": [
            "sufficient",
            "partial",
            "insufficient",
            "unknown"
          ]
        },
        "claim_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "unresolved_core_conflict": {
          "type": "boolean"
        },
        "noncore_gaps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "assessment_id",
        "target_id",
        "gates",
        "episode_integrity",
        "evidence_status",
        "claim_ids",
        "unresolved_core_conflict",
        "noncore_gaps"
      ],
      "additionalProperties": false
    },
