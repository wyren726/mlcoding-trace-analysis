          ],
          "minLength": 1,
          "readOnly": true,
          "description": "程序依据冻结分类表或本案例要求回填，模型不生成。"
        },
        "subrequirement_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sub_[0-9]{3}$",
          "readOnly": true,
          "description": "程序依据冻结分类表或本案例要求回填，模型不生成。"
        },
        "subrequirement_name": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "readOnly": true,
          "description": "程序依据冻结分类表或本案例要求回填，模型不生成。"
        },
        "case_requirement_text": {
          "type": "string",
          "minLength": 1,
          "readOnly": true,
          "description": "程序依据冻结分类表或本案例要求回填，模型不生成。"
        },
        "taxonomy_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "description": "程序依据冻结分类表或本案例要求回填，模型不生成。"
        }
