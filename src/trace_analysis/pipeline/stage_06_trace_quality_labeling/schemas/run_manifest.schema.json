{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trace-analysis.local/schemas/stage06/v1/run_manifest.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "stage06-v1-draft"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "pending",
        "running",
        "complete",
        "partial",
        "failed"
      ]
    },
    "config_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "code_revision": {
      "type": "string",
      "minLength": 1
    },
    "counts": {
      "type": "object",
      "properties": {
        "input": {
          "type": "integer",
          "minimum": 0
        },
        "eligible": {
          "type": "integer",
          "minimum": 0
        },
        "succeeded": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "pending": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "input",
        "eligible",
        "succeeded",
        "failed",
        "pending"
      ],
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "role",
          "path",
          "sha256"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "status",
    "config_manifest_sha256",
    "model",
    "code_revision",
    "counts",
    "artifacts"
  ],
  "additionalProperties": false
}
