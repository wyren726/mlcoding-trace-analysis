.DS_Store
.env
.env.*
!.env.example
.venv/
.claude/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.pipeline-cache/
pipeline-runs/
!pipeline-runs/
pipeline-runs/*
!pipeline-runs/*.schema.yaml
configs/.vscode_run.generated.json

# Raw and generated data are synchronized through the artifact store, not Git.
raw_data/
preprocessed/*
!preprocessed/*.schema.yaml
features/*
!features/*.schema.yaml
analysis/*
!analysis/*.schema.yaml
outputs/
archive/
.cache/

# Quality-filter code and schemas are tracked; all experiment inputs/results are artifacts.
quality_filter/*
!quality_filter/*.py
!quality_filter/docs/
!quality_filter/docs/**

# Local installation and synchronization diagnostics.
.install.log
*.log

# Large data / external project directories (kept out of Git).
hosted-capability-site/
hosted-capability-site-clean-importer/
workspace/

# Registry records are artifacts; only the schema is tracked.
registries/analysis-runs/
registries/datasets/

# Generated reports remain local; maintain the shared workflow guide in Git.
docs/*
!docs/TRACE_SCREENING_WORKFLOW.md
