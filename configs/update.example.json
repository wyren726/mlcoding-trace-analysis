{
  "sources": ["raw_data/<新增日志文件或目录>"],
  "adapter": null,
  "limit": null,
  "semantic_features": [
    "user_feedback",
    "task_outcome",
    "difficulty",
    "demand_capability_instances"
  ],
  "semantic_limit": null,
  "historical_capability_features": [],
  "existing_taxonomy": null,
  "review_decisions": null,
  "hierarchy_operations": null,
  "enable_human_review": false,
  "extension_feature_files": [],
  "extensions": [
    "model_comparison",
    "harness_comparison",
    "training_selection",
    "unmet_need_priority"
  ],
  "generate_review_suggestions": false,
  "merge_threshold": 0.65,
  "split_similarity_threshold": 0.32,
  "split_min_cases": 4,
  "split_min_cluster_size": 2,
  "roots": {
    "preprocessed": "preprocessed",
    "features": "features",
    "analysis": "analysis"
  },
  "runs_root": "pipeline-runs",
  "llm": {
    "dry_run": true,
    "provider": "pjlab_proxy",
    "model": "deepseek-v4-flash-0731",
    "provider_config": "configs/providers.toml",
    "cache_dir": ".cache/llm",
    "max_input_chars": 8000,
    "timeout_seconds": 60,
    "max_retries": 0
  }
}
