{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pair_id", "candidate_a_index", "candidate_b_index", "hard_gate_status",
    "triggered_gates", "rubric_preferences", "winner", "confidence",
    "reason_codes", "evidence_a", "evidence_b", "reason"
  ],
  "properties": {
    "pair_id": {"type": "string"},
    "candidate_a_index": {"type": "integer"},
    "candidate_b_index": {"type": "integer"},
    "hard_gate_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["A", "B"],
      "properties": {
        "A": {"enum": ["pass", "review", "reject"]},
        "B": {"enum": ["pass", "review", "reject"]}
      }
    },
    "triggered_gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["A", "B"],
      "properties": {
        "A": {"type": "array", "items": {"enum": ["G01", "G02", "G03", "G04", "G05", "G06", "G07", "G08", "G09", "G10", "G11", "G12", "G13"]}},
        "B": {"type": "array", "items": {"enum": ["G01", "G02", "G03", "G04", "G05", "G06", "G07", "G08", "G09", "G10", "G11", "G12", "G13"]}}
      }
    },
    "rubric_preferences": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Q1", "Q2", "Q3", "Q4", "Q5", "Q6", "Q7", "Q8", "V1", "V2", "V3", "V4", "V5", "V6"],
      "properties": {
        "Q1": {"enum": ["A", "B", "tie", "NA"]},
        "Q2": {"enum": ["A", "B", "tie", "NA"]},
        "Q3": {"enum": ["A", "B", "tie", "NA"]},
        "Q4": {"enum": ["A", "B", "tie", "NA"]},
        "Q5": {"enum": ["A", "B", "tie", "NA"]},
        "Q6": {"enum": ["A", "B", "tie", "NA"]},
        "Q7": {"enum": ["A", "B", "tie", "NA"]},
        "Q8": {"enum": ["A", "B", "tie", "NA"]},
        "V1": {"enum": ["A", "B", "tie", "NA"]},
        "V2": {"enum": ["A", "B", "tie", "NA"]},
        "V3": {"enum": ["A", "B", "tie", "NA"]},
        "V4": {"enum": ["A", "B", "tie", "NA"]},
        "V5": {"enum": ["A", "B", "tie", "NA"]},
        "V6": {"enum": ["A", "B", "tie", "NA"]}
      }
    },
    "winner": {"enum": ["A", "B", "tie", "both_bad"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "reason_codes": {"type": "array", "items": {"type": "string"}},
    "evidence_a": {"type": "array", "items": {"type": "integer", "minimum": 0}},
    "evidence_b": {"type": "array", "items": {"type": "integer", "minimum": 0}},
    "reason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hard_gate_comparison", "quality_comparison", "training_value_comparison", "decisive_reason"],
      "properties": {
        "hard_gate_comparison": {"type": "string", "minLength": 1},
        "quality_comparison": {"type": "string", "minLength": 1},
        "training_value_comparison": {"type": "string", "minLength": 1},
        "decisive_reason": {"type": "string", "minLength": 1}
      }
    }
  }
}
