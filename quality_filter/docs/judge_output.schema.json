{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pilot_index",
    "sample_id",
    "hard_gate_status",
    "hard_gate_results",
    "quality_rubric_results",
    "training_value_rubric_results",
    "quality_score",
    "training_value_score",
    "judge_confidence",
    "decision",
    "decision_reasons"
  ],
  "properties": {
    "pilot_index": {"type": "integer"},
    "sample_id": {"type": "string"},
    "hard_gate_status": {"enum": ["pass", "review", "reject"]},
    "hard_gate_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate_id", "triggered", "outcome", "evidence_message_indices", "reason"],
        "properties": {
          "gate_id": {"type": "string"},
          "triggered": {"type": "boolean"},
          "outcome": {"enum": ["pass", "review", "reject"]},
          "evidence_message_indices": {"type": "array", "items": {"type": "integer"}},
          "reason": {"type": "string"}
        }
      }
    },
    "quality_rubric_results": {
      "type": "array",
      "items": {"$ref": "#/$defs/rubric_result"}
    },
    "training_value_rubric_results": {
      "type": "array",
      "items": {"$ref": "#/$defs/rubric_result"}
    },
    "quality_score": {"type": "number", "minimum": 0, "maximum": 100},
    "training_value_score": {"type": "number", "minimum": 0, "maximum": 100},
    "judge_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "decision": {"enum": ["high_quality", "usable", "review", "reject"]},
    "decision_reasons": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "rubric_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rubric_id", "applicability", "raw_score", "evidence_message_indices", "reason", "confidence"],
      "properties": {
        "rubric_id": {"type": "string"},
        "applicability": {"enum": ["applicable", "not_applicable"]},
        "raw_score": {"type": ["integer", "null"], "minimum": 0, "maximum": 4},
        "evidence_message_indices": {"type": "array", "items": {"type": "integer"}},
        "reason": {"type": "string"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  }
}
